NODE_ENV=production
COOKIE_SECURE=1
DATABASE_URL=postgres://YOUR_USER:YOUR_ENCODED_PASSWORD@YOUR_HOST:YOUR_PORT/YOUR_DATABASE
# Paste Aiven certificate using literal backslash-n separators, or use Render's multiline environment value.
AIVEN_CA_CERT="-----BEGIN CERTIFICATE-----\nYOUR_CERTIFICATE\n-----END CERTIFICATE-----"
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET
# Only required while running npm run admin:create; remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=club_admin
ADMIN_NAME=Club administrator
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
