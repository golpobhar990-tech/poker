# Node.js 24+. Copy to .env and fill your own credentials.
PORT=5000
NODE_ENV=development
# Set to 1 behind HTTPS in production. Local HTTP needs 0.
COOKIE_SECURE=0

# Aiven PostgreSQL service URI (not MySQL). URL-encode special password characters.
DATABASE_URL=
# Download your Aiven project's CA certificate and place it here.
AIVEN_CA_PATH=./certs/ca.pem
# Alternative to a file: full PEM, with literal \n between lines.
# AIVEN_CA_CERT=

# Server-side Cloudinary credentials; never put these in public/.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Set only to run npm run admin:create; then remove ADMIN_PASSWORD.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_NAME=Club administrator
ADMIN_PASSWORD=
